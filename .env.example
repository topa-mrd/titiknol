# Salin ke .env.local lalu isi. Semua boleh kosong: aplikasi berjalan penuh
# dalam mode demo (AI tiruan + penyimpanan localStorage).

# Supabase (kosongkan → mode demo dengan localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # atau NEXT_PUBLIC_SUPABASE_ANON_KEY

# AI — hanya dibaca di server. JANGAN beri prefix NEXT_PUBLIC_.
GEMINI_API_KEY=                            # juga untuk pencarian sumber web (Google Search) tiap roadmap dibuat
GEMINI_MODEL=                              # opsional, menimpa rantai model default
OPENROUTER_API_KEY=                        # opsional, cadangan
OPENROUTER_MODEL=                          # mis. model gratis pilihanmu di openrouter.ai/models
AI_PROVIDER=                               # opsional paksa: gemini | openrouter | mock
AI_FALLBACK_TO_MOCK=true                   # false = tampilkan error alih-alih jawaban tiruan

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opsional, hanya untuk `npm run db:apply` di mesin developer (jangan diset di Vercel).
SUPABASE_DB_URL=

# Server saja: menyimpan hasil pencarian web Gemini ke katalog (resources + search_cache) dan
# perkiraan harga AI ke price_estimates. Tanpa ini pencarian web dilewati (link web wajib tersimpan dulu).
# Ambil "secret key" (sb_secret_…) di Supabase → Project Settings → API Keys. JANGAN beri prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Opsional: kurs USD→IDR untuk konversi harga hasil pencarian AI (default 16500).
PRICE_USD_IDR=
